{
  "name": "latex-editor",
  "version": "0.1.0",
  "private": true,
  "description": "Local, vault-based LaTeX editor",
  "main": "./out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.web.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run --project unit",
    "test:e2e": "vitest run --project e2e",
    "fixtures:logs": "vite-node scripts/gen-error-logs.ts"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@types/node": "^24.19.0",
    "electron": "^44.4.5",
    "electron-vite": "^5.0.0",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "vite": "^7.3.6",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/legacy-modes": "^6.5.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "chokidar": "^5.0.0",
    "codemirror": "^6.0.2",
    "pdfjs-dist": "^6.3.289"
  }
}
