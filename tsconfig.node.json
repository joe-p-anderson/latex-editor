{
  "compilerOptions": {
    "composite": true,
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"],
    "paths": { "@shared/*": ["./src/shared/*"] }
  },
  "include": ["electron.vite.config.ts", "vitest.config.ts", "src/main/**/*", "src/preload/**/*", "src/shared/**/*", "src/plugins/**/*.ts", "tests/**/*", "scripts/**/*"],
  "exclude": ["src/plugins/renderer.ts", "src/plugins/*/renderer.ts", "src/plugins/*/ui/**"]
}
