  doi = {10.1016/S0022-5096(03)00093-0},
  urldate = {2021-02-25},
  abstract = {Driving forces for dislocation motion and nucleation in finite-deformation field dislocation mechanics are derived. The former establishes a rigorous analog of the Peach-Koehler force of classical elastic dislocation theory in a nonlinear, nonequilibrium field-theoretic context; the latter is a prediction of the theory. The structure of the stress response and permanent distortion are also derived. Sufficient boundary and initial conditions are indicated, and invariance under superposed rigid motions is discussed. Hyperelasticity and finite-deformation elastic theory of dislocations are shown to be special cases of the framework. Owing to the nonlocal nature of the theory, the results as well as the methods used to derive them appear to be novel. {\copyright} 2003 Elsevier Ltd. All rights reserved.},
  keywords = {Dislocation mechanics,Dislocation nucleation,Dislocation velocity,Driving forces,Finite deformation},
