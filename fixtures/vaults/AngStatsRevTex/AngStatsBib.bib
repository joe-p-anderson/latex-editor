@article{sauzayScalingLawsDislocation2011,
  title = {Scaling Laws for Dislocation Microstructures in Monotonic and Cyclic Deformation of Fcc Metals},
  author = {Sauzay, M. and Kubin, L. P.},
  year = {2011},
