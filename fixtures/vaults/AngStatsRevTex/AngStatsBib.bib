@article{Sills2014,
  title = {Efficient Time Integration in Dislocation Dynamics},
  author = {Sills, Ryan B. and Cai, Wei},
  year = {2014},
  month = jan,
  journal = {Modelling and Simulation in Materials Science and Engineering},
  volume = {22},
  number = {2},
