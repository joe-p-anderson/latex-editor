@article{madecRoleCrossslipCollinear2024,
  title = {On the Role of Cross-Slip and Collinear Annihilation in Dynamic Recovery},
  author = {Madec, Ronan and Devincre, Benoit and Kubin, Ladislas},
  year = {2024},
  month = dec,
  journal = {Modelling and Simulation in Materials Science and Engineering},
