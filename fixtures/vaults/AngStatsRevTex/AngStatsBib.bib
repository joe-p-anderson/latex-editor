@article{kuykendallStressEffectsEnergy2020,
  title = {Stress Effects on the Energy Barrier and Mechanisms of Cross-Slip in {{FCC}} Nickel},
  author = {Kuykendall, William P. and Wang, Yifan and Cai, Wei},
  year = {2020},
  month = nov,
  journal = {Journal of the Mechanics and Physics of Solids},
