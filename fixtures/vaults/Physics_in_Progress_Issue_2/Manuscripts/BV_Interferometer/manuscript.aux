\@writefile{toc}{\contentsline {title}{Riding the wave: determining laser wavelength using a Michelson interferometer}{7}{}}
\@writefile{toc}{\contentsline {abstract}{Abstract}{7}{}}
\@writefile{toc}{\contentsline {section}{\numberline {I}Introduction}{7}{}}
\@writefile{toc}{\contentsline {section}{\numberline {II}Key Findings}{7}{}}
\citation{pasco_mini_laser}
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces A schematic of the Michelson interferometer used in this experiment. Light from a helium–neon laser is split by a beam-splitter and reflected by a stationary mirror (M1) and a movable mirror (M2). The two beams recombine at the beam splitter and form an interference pattern on the viewing screen. Displacement, $d$, of mirror M2 changes the optical path difference between the beams.}}{8}{}}
\newlabel{fig:drawing}{{1}{8}{}{}{}}
\newlabel{fig:drawing@cref}{{[figure][1][]1}{[1][7][]8}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Interference fringe pattern observed on the viewing screen after alignment of the Michelson interferometer. Bright and dark circular fringes result from constructive and destructive interference of the two coherent beams. Fringe shifts, $m$, were counted as mirror M2 was displaced.}}{8}{}}
\newlabel{fig:fringes}{{2}{8}{}{}{}}
\newlabel{fig:fringes@cref}{{[figure][2][]2}{[1][7][]8}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Mirror displacement as a function of fringe count for a HeNe laser. A least squares linear fit with the y-intercept constrained to zero was applied to the data, yielding a slope of $M$ = 326 $\pm $ 3 nm/fringe.}}{8}{}}
\newlabel{fig:slope}{{3}{8}{}{}{}}
\newlabel{fig:slope@cref}{{[figure][3][]3}{[1][7][]8}{}{}{}}
